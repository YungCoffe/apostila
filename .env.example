# Nunca compartilhe o token nem inclua .env no Git.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Só ative após habilitar Message Content no Developer Portal do Discord.
# APOSTILA_PREFIX_ENABLED=1
# Opcional: registro de comando apenas neste servidor (aparece mais rápido).
DISCORD_GUILD_ID=
# Opcional: caminho absoluto para o arquivo JSON, se estiver fora do projeto.
# A montagem de um arquivo persistente permite atualizar os links sem alterar a imagem do bot.
# APOSTILAS_CONFIG=/dados/apostilas.json
